# Sanity project configuration.
# Find these in https://sanity.io/manage (or run `npx sanity init`).
# These are client-exposed (public dataset), so no read token is required.
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: pin the API/schema date. Defaults to 2024-03-01 if unset.
# NEXT_PUBLIC_SANITY_API_VERSION=2024-03-01
